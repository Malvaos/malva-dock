// Malva Dock: a macOS-style dock with fisheye magnification.
//
// Rust supplies the items and their resting geometry (`u` = left edge, `bw` = width, measured
// from the start of the dock). Everything else, including the magnification, is computed here.
//
// Magnification uses a closed-form "fisheye" mapping: every resting position `u` is pushed away
// from the pointer by `warp(u)`. Because the mapping is smooth and monotonic, neighbours make
// room for the enlarged icon and nothing ever overlaps. The point under the pointer never moves,
// so hit-testing can be done on the resting layout (see `item-clicked`).

export struct DockItem {
    key: string,
    name: string,
    initial: string,
    image: image,
    has-image: bool,
    u: length,
    bw: length,
    separator: bool,
    running: bool,
    launching: bool,
}

export global Theme {
    in-out property <bool> dark: true;
    // Leave empty for the system UI font, or set a family such as "Inter".
    in-out property <string> font: "";

    // Malva palette, approximated from its description. Swap in the exact swatches here.
    out property <color> lilac-light: #efe5f7;
    out property <color> lilac: #d6bdec;
    out property <color> orchid: #e58bd2;
    out property <color> plum: #5c2256;
    out property <color> leaf: #7be0a4;

    out property <brush> bar: dark
        ? @linear-gradient(180deg, #3a3a40d6 0%, #1d1d21dc 100%)
        : @linear-gradient(180deg, #ffffffd2 0%, #e8e8eed2 100%);
    out property <color> bar-border: dark ? #ffffff33 : #ffffffe0;
    out property <color> dot: dark ? #ffffffe0 : #000000b8;
    out property <color> separator: dark ? #ffffff38 : #00000028;
    out property <color> tip-bg: #26262af0;
    out property <color> tip-fg: #ffffff;
}

// Built-in Malva system icons: one glyph on a gradient tile. Glyphs are SVG paths on a 24x24 grid.
global Icons {
    public pure function path(key: string) -> string {
        if (key == "apps") {
            return "M6 6 H6.1 M12 6 H12.1 M18 6 H18.1 M6 12 H6.1 M12 12 H12.1 M18 12 H18.1 M6 18 H6.1 M12 18 H12.1 M18 18 H18.1";
        }
        if (key == "files") {
            return "M3.5 7.5 A1.5 1.5 0 0 1 5 6 H9.2 L11.2 8 H19 A1.5 1.5 0 0 1 20.5 9.5 V17 A1.5 1.5 0 0 1 19 18.5 H5 A1.5 1.5 0 0 1 3.5 17 Z";
        }
        if (key == "browser") {
            return "M20.5 12 A8.5 8.5 0 1 1 3.5 12 A8.5 8.5 0 1 1 20.5 12 Z M3.5 12 H20.5 M12 3.5 C9.2 6.8 9.2 17.2 12 20.5 M12 3.5 C14.8 6.8 14.8 17.2 12 20.5 M5.2 8.2 H18.8 M5.2 15.8 H18.8";
        }
        if (key == "notes") {
            return "M7 4.5 H17 A2 2 0 0 1 19 6.5 V17.5 A2 2 0 0 1 17 19.5 H7 A2 2 0 0 1 5 17.5 V6.5 A2 2 0 0 1 7 4.5 Z M8.5 9.5 H15.5 M8.5 13 H15.5 M8.5 16.5 H12.5";
        }
        if (key == "calculator") {
            return "M7 3.5 H17 A2 2 0 0 1 19 5.5 V18.5 A2 2 0 0 1 17 20.5 H7 A2 2 0 0 1 5 18.5 V5.5 A2 2 0 0 1 7 3.5 Z M8.5 8 H15.5 M8.6 12.2 H8.7 M12 12.2 H12.1 M15.3 12.2 H15.4 M8.6 15.6 H8.7 M12 15.6 H12.1 M15.3 15.6 H15.4";
        }
        if (key == "terminal") {
            return "M6 8 L11 12 L6 16 M13 16.5 H18.5";
        }
        if (key == "keyboard") {
            return "M5 7 H19 A2 2 0 0 1 21 9 V15 A2 2 0 0 1 19 17 H5 A2 2 0 0 1 3 15 V9 A2 2 0 0 1 5 7 Z M7 10.3 H7.1 M10.3 10.3 H10.4 M13.6 10.3 H13.7 M16.9 10.3 H17 M8.5 13.7 H15.5";
        }
        if (key == "settings") {
            return "M4.5 7 H7.2 M10.8 7 H19.5 M10.8 7 A1.8 1.8 0 1 1 7.2 7 A1.8 1.8 0 1 1 10.8 7 Z M4.5 12 H13.2 M16.8 12 H19.5 M16.8 12 A1.8 1.8 0 1 1 13.2 12 A1.8 1.8 0 1 1 16.8 12 Z M4.5 17 H5.2 M8.8 17 H19.5 M8.8 17 A1.8 1.8 0 1 1 5.2 17 A1.8 1.8 0 1 1 8.8 17 Z";
        }
        if (key == "downloads") {
            return "M12 4.5 V14.5 M7.5 10.5 L12 15 L16.5 10.5 M5 19.5 H19";
        }
        if (key == "trash") {
            return "M4.5 7 H19.5 M9.5 7 V5 A1 1 0 0 1 10.5 4 H13.5 A1 1 0 0 1 14.5 5 V7 M6.5 7 L7.5 19 A1.5 1.5 0 0 0 9 20.5 H15 A1.5 1.5 0 0 0 16.5 19 L17.5 7 M10 11 V16.5 M14 11 V16.5";
        }
        return "M 0 0";
    }

    public pure function top(key: string) -> color {
        if (key == "apps") { return #ffffff; }
        if (key == "files") { return #e07cc8; }
        if (key == "browser") { return #c3a9f0; }
        if (key == "notes") { return #f7eefb; }
        if (key == "calculator") { return #4b4b52; }
        if (key == "fonts") { return #ffffff; }
        if (key == "terminal") { return #303036; }
        if (key == "keyboard") { return #8b8b94; }
        if (key == "settings") { return #b5b5be; }
        if (key == "downloads") { return #4fa57f; }
        if (key == "trash") { return Theme.dark ? #ffffff3a : #0000002a; }
        return #8e8e96;
    }

    public pure function bottom(key: string) -> color {
        if (key == "apps") { return #d9d4e2; }
        if (key == "files") { return #8f3480; }
        if (key == "browser") { return #7452c9; }
        if (key == "notes") { return #dcc8ef; }
        if (key == "calculator") { return #1f1f23; }
        if (key == "fonts") { return #e4dcec; }
        if (key == "terminal") { return #0f0f12; }
        if (key == "keyboard") { return #4e4e57; }
        if (key == "settings") { return #7a7a85; }
        if (key == "downloads") { return #1f5a41; }
        if (key == "trash") { return Theme.dark ? #ffffff1a : #00000014; }
        return #5a5a62;
    }

    public pure function glyph(key: string) -> color {
        if (key == "apps") { return Theme.plum; }
        if (key == "notes") { return Theme.plum; }
        if (key == "fonts") { return Theme.plum; }
        if (key == "calculator") { return Theme.orchid; }
        if (key == "terminal") { return Theme.leaf; }
        if (key == "trash") { return Theme.dark ? #ffffffe6 : #000000a6; }
        return #ffffff;
    }

    // Stroke-width multiplier: the "apps" grid is drawn as dots, so it needs a thick stroke.
    public pure function weight(key: string) -> float {
        if (key == "apps") { return 1.9; }
        return 1;
    }
}

// One app icon: a gradient tile with a single glyph, an image, or a letter.
component Tile inherits Rectangle {
    in property <DockItem> item;
    in property <bool> down;

    border-radius: self.width * 0.225;
    background: root.item.has-image ? transparent : @linear-gradient(180deg, Icons.top(root.item.key) 0%, Icons.bottom(root.item.key) 100%);
    opacity: root.item.has-image && root.down ? 0.7 : 1;
    drop-shadow-blur: root.item.has-image ? 0px : self.width * 0.14;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: self.width * 0.05;
    border-width: root.item.has-image ? 0px : 1px;
    border-color: Theme.dark ? #ffffff30 : #00000022;

    // Soft gloss on the top half.
    Rectangle {
        visible: !root.item.has-image;
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: @linear-gradient(180deg, #ffffff3c 0%, #ffffff00 55%);
    }

    Path {
        visible: root.item.key != "custom" && root.item.key != "fonts";
        width: parent.width * 0.56;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Icons.path(root.item.key);
        stroke: Icons.glyph(root.item.key);
        stroke-width: self.width / 24 * 1.9 * Icons.weight(root.item.key);
        stroke-line-cap: round;
        fill: transparent;
    }

    Text {
        visible: root.item.key == "fonts" || (root.item.key == "custom" && !root.item.has-image);
        width: parent.width;
        height: parent.height;
        text: root.item.key == "fonts" ? "Aa" : root.item.initial;
        font-family: Theme.font;
        font-size: parent.width * 0.4;
        font-weight: 700;
        color: Icons.glyph(root.item.key);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Image {
        visible: root.item.has-image;
        source: root.item.image;
        image-fit: contain;
        width: parent.width;
        height: parent.height;
    }

    // Pressed feedback: the tile darkens.
    Rectangle {
        visible: !root.item.has-image;
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.down ? #00000050 : #00000000;
        animate background {
            duration: 90ms;
        }
    }
}

export component DockWindow inherits Window {
    title: "Malva Dock";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <[DockItem]> items;
    // Width of all items at rest, from the first item's left edge to the last item's right edge.
    in property <length> content-width: 700px;
    in property <length> icon-size: 56px;
    in property <length> gap: 8px;
    // Size of the icon right under the pointer, relative to its resting size.
    in property <float> max-scale: 1.7;

    // Pointer x, measured from the start of the dock at rest. Rust turns it into an item.
    callback item-clicked(length);

    property <length> pad: 14px;
    property <length> vpad: 10px;
    // Distance over which magnification fades out on each side of the pointer.
    property <length> reach: 3 * (root.icon-size + root.gap);
    property <length> bar-h: root.icon-size + 2 * root.vpad;
    property <length> bottom-gap: 16px;
    property <length> top-room: (root.max-scale - 1) * root.icon-size + 46px;
    // Left margin that leaves room for the dock to widen while it magnifies.
    property <length> edge-x: root.pad + (root.max-scale - 1) * root.reach / 2 + 20px;
    property <length> bar-y: root.height - root.bottom-gap - root.bar-h;
    property <length> baseline: root.bar-y + root.bar-h - root.vpad;

    property <length> p: touch.x + touch.mouse-x - root.edge-x;
    property <float> mag: touch.has-hover ? 1 : 0;
    animate mag {
        duration: 160ms;
        easing: ease-out;
    }

    preferred-width: root.content-width + 2 * root.edge-x;
    preferred-height: root.top-room + root.bar-h + root.bottom-gap;

    // Where a resting position `u` ends up with the pointer at `p`.
    pure function warp(u: length) -> length {
        return u + (u < root.p ? -1 : 1) * root.mag * (root.max-scale - 1) * (
            min(abs(u - root.p), root.reach) / 2
            + root.reach / 6.2832 * sin(180deg * (min(abs(u - root.p), root.reach) / root.reach))
        );
    }

    // The glass bar widens and narrows with the icons.
    Rectangle {
        x: root.edge-x + root.warp(-root.pad);
        y: root.bar-y;
        width: root.warp(root.content-width + root.pad) - root.warp(-root.pad);
        height: root.bar-h;
        border-radius: 24px;
        background: Theme.bar;
        border-width: 1px;
        border-color: Theme.bar-border;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000066;
        drop-shadow-offset-y: 10px;
    }

    for item[i] in root.items : Rectangle {
        property <length> left: root.edge-x + root.warp(item.u);
        property <length> size: root.warp(item.u + item.bw) - root.warp(item.u);
        property <bool> hot: touch.has-hover && root.p >= item.u - root.gap / 2 && root.p < item.u + item.bw + root.gap / 2;
        // Launch feedback: the icon hops while its app starts.
        property <length> hop: item.launching ? abs(sin(animation-tick() / 300ms * 180deg)) * self.size * 0.3 : 0px;

        x: self.left;
        y: root.baseline - self.size;
        width: self.size;
        height: self.size;

        if item.separator : Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - root.icon-size / 2 - self.height / 2;
            width: 1px;
            height: root.icon-size * 0.72;
            background: Theme.separator;
        }

        if !item.separator : Tile {
            y: -parent.hop;
            width: parent.width;
            height: parent.height;
            item: item;
            down: touch.pressed && parent.hot;
        }

        // Dot under running apps.
        if item.running && !item.separator : Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height + 4px;
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: Theme.dot;
        }
    }

    // Labels sit in a second pass so they always draw above every icon.
    for item[i] in root.items : Rectangle {
        property <length> size: root.warp(item.u + item.bw) - root.warp(item.u);
        property <length> centre: root.edge-x + (root.warp(item.u) + root.warp(item.u + item.bw)) / 2;
        property <bool> hot: touch.has-hover && root.p >= item.u - root.gap / 2 && root.p < item.u + item.bw + root.gap / 2;

        visible: self.hot && !item.separator && !touch.pressed;
        x: self.centre - self.width / 2;
        y: root.baseline - self.size - self.height - 12px;
        width: label.preferred-width + 26px;
        height: 30px;
        border-radius: 9px;
        background: Theme.tip-bg;
        border-width: 1px;
        border-color: #ffffff1f;

        label := Text {
            x: 13px;
            y: 0px;
            height: parent.height;
            text: item.name;
            color: Theme.tip-fg;
            font-family: Theme.font;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    // One touch area over the whole dock: the pointer position drives the magnification.
    touch := TouchArea {
        x: root.edge-x - root.pad - 12px;
        y: root.bar-y - (root.max-scale - 1) * root.icon-size - 8px;
        width: root.content-width + 2 * root.pad + 24px;
        height: root.height - self.y;
        clicked => {
            root.item-clicked(root.p);
        }
    }
}
